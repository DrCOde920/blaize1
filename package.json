{
  "name": "blaize-accountable-desktop",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release server.js",
    "lint": "tsc --noEmit",
    "desktop:dev": "tsx scripts/build-desktop.ts --dev",
    "desktop:build": "tsx scripts/build-desktop.ts",
    "desktop:package": "tsx scripts/package-electron.ts --target=current",
    "desktop:package:linux": "tsx scripts/package-electron.ts --target=linux",
    "desktop:package:win": "tsx scripts/package-electron.ts --target=win",
    "desktop:package:mac": "tsx scripts/package-electron.ts --target=mac",
    "desktop:lifecycle": "tsx scripts/package-desktop.ts --verify-lifecycle",
    "desktop:verify-bundle": "node scripts/verify-desktop-remediation.mjs",
    "test:electron": "tsx --test src/packages/platform/electron_desktop.test.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "verify": "tsx scripts/verify.ts",
    "eval": "tsx scripts/run-eval.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "prettier": "^3.9.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
