# MODEL_API_KEY: Meta Model API key for https://api.meta.ai/v1 (Responses, Computer Use, Voice Transcribe, Muse Image, SAM 3.1)
MODEL_API_KEY="YOUR_META_MODEL_API_KEY"
META_API_BASE_URL="https://api.meta.ai/v1"

# Optional Baseten / Self-Hosted Open Weights Endpoint (meta-models/muse-spark-open-1026)
SPARK_OPEN_ENDPOINT=""
SPARK_OPEN_API_KEY=""

# Optional Local Muse Glimmer Endpoint (vLLM / SGLang / llama.cpp / ExecuTorch)
GLIMMER_LOCAL_ENDPOINT="http://127.0.0.1:8080/v1"

# Optional Remote Approval Telegram Bot (outbound only, whitelisted user id)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WHITELISTED_USER_ID=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

